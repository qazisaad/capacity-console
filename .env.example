# Configuration contract consumed by src/server/env.ts. `npm run setup` writes a private .local/app.env with generated secrets.
APP_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_URL=
BETTER_AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_ID=k1
# Optional previous key for controlled rotation.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS_ID=
# One-time installation secret; remove after the first administrator exists.
BOOTSTRAP_TOKEN=
# Optional email delivery (not consumed yet; invitation links are copied by administrators).
SMTP_URL=
SMTP_FROM=
